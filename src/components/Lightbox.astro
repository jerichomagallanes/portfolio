---
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang].snapshots;
---

<dialog id="lightbox" class="lightbox bg-transparent p-0" aria-label={t.view}>
  <figure class="m-0 flex flex-col items-center gap-3">
    <img
      id="lightbox-img"
      src=""
      alt=""
      class="border-line block border select-none"
      draggable="false"
    />
    <div class="flex w-full items-baseline justify-between gap-6 px-1">
      <figcaption id="lightbox-caption" class="lightbox-text font-mono text-[12px] tracking-wide">
      </figcaption>
      <button
        id="lightbox-close"
        type="button"
        class="lightbox-text font-mono text-[12px] tracking-wider uppercase transition-opacity hover:opacity-70"
      >
        {t.close} ✕
      </button>
    </div>
    <div id="lightbox-controls" class="mt-1 hidden items-center gap-6">
      <button
        id="lightbox-prev"
        type="button"
        aria-label={t.prev}
        class="lightbox-text font-mono text-base transition-opacity hover:opacity-70"
      >
        ←
      </button>
      <div id="lightbox-dots" class="flex gap-2.5" data-goto={t.goTo}></div>
      <button
        id="lightbox-next"
        type="button"
        aria-label={t.next}
        class="lightbox-text font-mono text-base transition-opacity hover:opacity-70"
      >
        →
      </button>
    </div>
  </figure>
</dialog>

<script>
  const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
  const img = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const caption = document.getElementById('lightbox-caption');
  const controls = document.getElementById('lightbox-controls');
  const dots = document.getElementById('lightbox-dots');
  const prev = document.getElementById('lightbox-prev');
  const next = document.getElementById('lightbox-next');

  if (dialog && img && caption && controls && dots && prev && next) {
    const group = [
      ...document.querySelectorAll<HTMLElement>('.photo-open[data-group="snapshots"]'),
    ];
    let current = -1;

    const show = (opener: HTMLElement) => {
      img.src = opener.dataset.src ?? '';
      img.alt = opener.dataset.alt ?? '';
      caption.textContent = opener.dataset.caption ?? '';
      dots.querySelectorAll('button').forEach((d, i) => {
        d.setAttribute('aria-current', String(i === current));
      });
    };

    const goTo = (i: number) => {
      current = (i + group.length) % group.length;
      show(group[current]);
    };

    group.forEach((_, i) => {
      const dot = document.createElement('button');
      dot.type = 'button';
      dot.className = 'snap-dot';
      dot.setAttribute('aria-label', `${dots.dataset.goto} ${i + 1}`);
      dot.addEventListener('click', () => goTo(i));
      dots.appendChild(dot);
    });

    document.addEventListener('click', (e) => {
      const opener = (e.target as HTMLElement).closest('.photo-open') as HTMLElement | null;
      if (opener) {
        const inGroup = opener.dataset.group === 'snapshots';
        controls.classList.toggle('hidden', !inGroup);
        controls.classList.toggle('flex', inGroup);
        if (inGroup) {
          goTo(Number(opener.dataset.index ?? 0));
        } else {
          current = -1;
          show(opener);
        }
        dialog.showModal();
        return;
      }
      if (e.target === dialog) dialog.close();
    });

    prev.addEventListener('click', () => goTo(current - 1));
    next.addEventListener('click', () => goTo(current + 1));
    dialog.addEventListener('keydown', (e) => {
      if (current < 0) return;
      if (e.key === 'ArrowLeft') goTo(current - 1);
      if (e.key === 'ArrowRight') goTo(current + 1);
    });
    document.getElementById('lightbox-close')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => {
      img.src = '';
    });
  }
</script>
