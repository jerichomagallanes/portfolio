---
import { ui, type Lang } from '../i18n/ui';
import type { Experience } from '../data/experience';

interface Props {
  e: Experience;
  lang: Lang;
  delay?: number;
}
const { e, lang, delay = 0 } = Astro.props;
const t = ui[lang].work;
---

<li
  class="reveal rule grid gap-3 py-8 md:grid-cols-[11rem_1fr] md:gap-8"
  style={`transition-delay: ${delay}ms`}
>
  <div class="font-mono text-[13px]">
    <p>{e.period[lang]}</p>
    <p class="text-stone mt-1">{e.location[lang]}</p>
  </div>
  <div>
    <h3 class="font-display text-xl font-bold tracking-tight md:text-2xl">
      <a
        href={e.url}
        target="_blank"
        rel="noopener"
        class="group/company hover:text-accent transition-colors"
      >
        {e.company}
        <span class="row-arrow text-accent ml-1 inline-block text-sm">↗</span>
      </a>
      <span class="text-stone ml-2 font-mono text-[13px] font-normal tracking-wider uppercase">
        {e.role[lang]}
      </span>
    </h3>
    <p class="text-stone mt-3 max-w-3xl leading-relaxed">{e.summary[lang]}</p>
    <p class="text-stone mt-4 font-mono text-[13px]">
      {e.stack.map((s, i) => (
        <>
          {i > 0 && <span class="text-accent"> · </span>}
          <span>{s}</span>
        </>
      ))}
    </p>
    {e.credit && (
      <p class="text-stone mt-3 font-mono text-[12px] tracking-wide">{e.credit[lang]}</p>
    )}
    {e.apps && (
      <div class="mt-7">
        <p class="text-stone font-mono text-[11px] tracking-wider uppercase">{t.shipped}</p>
        <ul class="mt-3 flex flex-wrap gap-x-9 gap-y-4">
          {e.apps.map((app) => (
            <li class="app-entry flex items-center gap-3">
              <img
                src={app.icon}
                alt=""
                width="88"
                height="88"
                loading="lazy"
                decoding="async"
                class="app-icon border-line bg-hover h-11 w-11 border"
              />
              <div>
                <p class="text-[14px] leading-tight font-medium">
                  {app.name}
                  {app.note && <span class="text-stone font-normal"> ({app.note[lang]})</span>}
                </p>
                <p class="mt-1.5 font-mono text-[11px] tracking-wide">
                  {app.appStore && (
                    <a
                      href={app.appStore}
                      target="_blank"
                      rel="noopener"
                      class="text-stone hover:text-accent decoration-line underline underline-offset-4 transition-colors"
                      aria-label={t.viewOn
                        .replace('{app}', app.name)
                        .replace('{store}', 'App Store')}
                    >
                      App Store ↗
                    </a>
                  )}
                  {app.appStore && app.playStore && <span class="text-accent"> · </span>}
                  {app.playStore && (
                    <a
                      href={app.playStore}
                      target="_blank"
                      rel="noopener"
                      class="text-stone hover:text-accent decoration-line underline underline-offset-4 transition-colors"
                      aria-label={t.viewOn
                        .replace('{app}', app.name)
                        .replace('{store}', 'Google Play')}
                    >
                      Google Play ↗
                    </a>
                  )}
                </p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</li>
