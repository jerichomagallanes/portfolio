---
import { ui, type Lang } from '../i18n/ui';
import { experience } from '../data/experience';
import WorkRow from './WorkRow.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang].work;
---

<section id="work" class="mx-auto max-w-6xl px-6 py-16 md:px-10 md:py-24">
  <p class="reveal text-stone font-mono text-[13px] tracking-wider uppercase">{t.eyebrow}</p>
  <h2 class="reveal font-display mt-4 mb-10 text-3xl font-bold tracking-tight md:mb-14 md:text-5xl">
    {t.heading}
  </h2>

  <ol class="border-line border-t">
    {experience.map((e, i) => <WorkRow e={e} lang={lang} delay={i * 90} />)}
  </ol>
</section>
