---
import { ui, type Lang } from '../i18n/ui';
import { snapshots } from '../data/photos';
import Photo from './Photo.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang].snapshots;
---

<section class="mx-auto max-w-6xl px-6 py-16 md:px-10 md:py-24">
  <p class="reveal text-stone font-mono text-[13px] tracking-wider uppercase">{t.eyebrow}</p>
  <div class="mt-8 grid grid-cols-2 gap-4 md:grid-cols-4 md:gap-6">
    {
      snapshots.map((photo, i) => (
        <Photo photo={photo} lang={lang} delay={i * 90} group="snapshots" index={i} />
      ))
    }
  </div>
</section>
